{
  "name": "repoatlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RepoAtlas: MCP server that turns a GitHub repo into a graph for guided onboarding and first-issue matching",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "precompute": "tsx scripts/precompute-snapshots.ts",
    "check-snapshots": "tsx scripts/check-snapshots.ts",
    "eval:backtest": "tsx scripts/eval/backtest.ts",
    "eval:keyfiles": "tsx scripts/eval/keyfiles.ts",
    "eval:handcheck": "tsx scripts/eval/handcheck.ts",
    "eval": "npm run eval:keyfiles && npm run eval:backtest && npm run eval:handcheck",
    "deploy:pack": "node scripts/pack-deploy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@nitrostack/core": "1.1.1",
    "dotenv": "^16.3.1",
    "graphology": "^0.26.0",
    "minisearch": "^7.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "1.1.1",
    "@octokit/graphql": "^9.0.5",
    "@types/node": "^22.10.0",
    "graphology-metrics": "^2.4.2",
    "simple-git": "^4.0.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "author": "Karthik",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
