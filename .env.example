# RepoAtlas configuration. Copy to .env (git-ignored). Never commit real values.

# --- RepoAtlas ---------------------------------------------------------------
# GitHub token. Used by the offline precompute script, and OPTIONAL on the server: with it,
# repos built on demand also get merged PRs, issue comments and per-commit file history, and
# GitHub downloads are not rate-limited by network address. Read-only, public data only
# (no scopes). Locally keep it in .env; on NitroCloud set it in the MCP's environment
# variables in the dashboard. Never paste it into chat or commit it.
GITHUB_TOKEN=

# Secret used to sign export_guide confirm tokens (HMAC-SHA256). Use a long random string.
EXPORT_SECRET=

# snapshot = default. live additionally allows refreshing issues and reading a GitHub
# username's languages at runtime (needs GITHUB_TOKEN). It does NOT control on-demand repo
# builds: those are LIVE_BUILDS below.
RUNTIME_MODE=snapshot
SNAPSHOT_DIR=data/snapshots

# Studio chat only (NitroStudio AI Chat). Not used by the server at runtime.
GEMINI_API_KEY=

# HTTP port for the MCP server (/mcp). NitroCloud may set this itself.
PORT=3000

# --- NitroStack --------------------------------------------------------------
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# MCP_TRANSPORT_TYPE: stdio | http | dual. Defaults to stdio in development and
# dual when NODE_ENV=production.
# MCP_TRANSPORT_TYPE=stdio
# HOST=localhost
# ENABLE_CORS=true

# NITRO_MCP_PROTOCOL_VERSION: auto (default) | 2026-07-28 | 2025-06-18
# NITRO_MCP_PROTOCOL_VERSION=auto

# Max RepoAtlas tool calls per session per hour (default 1500). Protects the free tier from loops.
# SESSION_CALL_BUDGET=1500

# --- On-demand repo builds (build_graph for any public GitHub repo) -----------
# LIVE_BUILDS=on                 # off = serve only the precomputed snapshots
# LIVE_BUILDS_PER_HOUR=40        # new repos built per hour, whole server (protects the free tier)
# LIVE_BUILD_TIMEOUT_MS=40000    # wall-clock budget for one build; slower repos return a partial graph
# LIVE_SNAPSHOT_TTL_MIN=360      # how long a built repo stays in memory
